[6.55, "o", "packer v2.0.0 - compress / encrypt / decompress with installed CLI tools\r\nCompression formats:\r\n"]
[6.6, "o", "  tar (.tar)\r\n    - tar [none/min/some/max]\r\n    - atool\r\n"]
[6.65, "o", "  zip (.zip)\r\n"]
[6.7, "o", "    - zip [none/min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n"]
[6.75, "o", "  tar.gz (.tar.gz)\r\n    - tar+gzip [min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n  tar.bz2 (.tar.bz2)\r\n"]
[6.8, "o", "    - tar+bzip2 [min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n  tar.xz (.tar.xz)\r\n    - tar+xz [min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n  tar.zst (.tar.zst)\r\n"]
[6.85, "o", "    - tar+zstd [min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n"]
[6.9, "o", "  7z (.7z)\r\n"]
[6.95, "o", "    - 7z (missing) [none/min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n\r\nEncryption methods:\r\n  age (.age) - age\r\n"]
[7.0, "o", "  gpg (.gpg) - gpg\r\n  openssl (.enc) - openssl\r\n"]
[7.05, "o", "  kryptor (.kryptor) - kryptor (missing)\r\n  picocrypt (.pcv) - picocrypt\r\n\r\nInfo backends:\r\n  tree (missing)\r\n"]
[7.1, "o", "  du\r\n"]
[7.15, "o", "  gdu (missing)\r\n"]
