[85.510019, "o", "packer v2.0.0 - compress / encrypt / decompress with installed CLI tools\r\nCompression formats:\r\n"]
[85.510155, "o", "  tar (.tar)\r\n    - tar [none/min/some/max]\r\n    - atool\r\n"]
[85.510188, "o", "  zip (.zip)\r\n    - zip [none/min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n  tar.gz (.tar.gz)\r\n    - tar+gzip [min/some/max]\r\n"]
[85.510199, "o", "    - ouch [min/some/max]\r\n    - atool\r\n"]
[85.510207, "o", "  tar.bz2 (.tar.bz2)\r\n"]
[85.510232, "o", "    - tar+bzip2 [min/some/max]\r\n    - ouch [min/some/max]\r\n"]
[85.510241, "o", "    - atool\r\n"]
[85.510502, "o", "  tar.xz (.tar.xz)\r\n    - tar+xz [min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n  tar.zst (.tar.zst)\r\n    - tar+zstd [min/some/max]\r\n"]
[85.510972, "o", "    - ouch [min/some/max]\r\n"]
[85.511037, "o", "    - atool\r\n"]
[85.511062, "o", "  7z (.7z)\r\n"]
[85.511083, "o", "    - 7z (missing) [none/min/some/max]\r\n"]
[85.511101, "o", "    - ouch [min/some/max]\r\n"]
[85.511105, "o", "    - atool\r\n\r\nEncryption methods:\r\n"]
[85.511145, "o", "  age (.age) - age\r\n  gpg (.gpg) - gpg\r\n"]
[85.511164, "o", "  openssl (.enc) - openssl\r\n"]
[85.51119, "o", "  kryptor (.kryptor) - kryptor (missing)\r\n"]
[85.511207, "o", "  picocrypt (.pcv) - picocrypt\r\n\r\nInfo backends:\r\n"]
[85.511223, "o", "  tree (missing)\r\n"]
[85.511241, "o", "  du\r\n"]
[85.51126, "o", "  gdu (missing)\r\n"]
