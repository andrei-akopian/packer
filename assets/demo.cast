[35.940294, "o", "\r\n"]
[36.018566, "o", "packer v2.0.0 - compress / encrypt / decompress with installed CLI tools\r\nCompression formats:\r\n"]
[36.018606, "o", "  tar (.tar)\r\n    - tar [none/min/some/max]\r\n    - atool\r\n"]
[36.018627, "o", "  zip (.zip)\r\n"]
[36.018722, "o", "    - zip [none/min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n"]
[36.018736, "o", "  tar.gz (.tar.gz)\r\n    - tar+gzip [min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n  tar.bz2 (.tar.bz2)\r\n"]
[36.018886, "o", "    - tar+bzip2 [min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n  tar.xz (.tar.xz)\r\n    - tar+xz [min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n  tar.zst (.tar.zst)\r\n"]
[36.018894, "o", "    - tar+zstd [min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n"]
[36.019044, "o", "  7z (.7z)\r\n"]
[36.019103, "o", "    - 7z (missing) [none/min/some/max]\r\n    - ouch [min/some/max]\r\n    - atool\r\n\r\nEncryption methods:\r\n  age (.age) - age\r\n"]
[36.019149, "o", "  gpg (.gpg) - gpg\r\n  openssl (.enc) - openssl\r\n"]
[36.019209, "o", "  kryptor (.kryptor) - kryptor (missing)\r\n  picocrypt (.pcv) - picocrypt\r\n\r\nInfo backends:\r\n  tree (missing)\r\n"]
[36.019216, "o", "  du\r\n"]
[36.019272, "o", "  gdu (missing)\r\n"]
